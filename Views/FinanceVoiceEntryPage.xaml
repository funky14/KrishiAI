<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.FinanceVoiceEntryPage"
             Title="Voice Entry (Finance)"
             BackgroundColor="#f8f9fa">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <Label Text="Language" FontAttributes="Bold" FontSize="14" TextColor="#2c2c2c" VerticalOptions="Center" />
                <Frame Grid.Column="1" Padding="5,0" CornerRadius="8" BorderColor="#e0e0e0" HasShadow="False">
                    <Picker ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" WidthRequest="100" />
                </Frame>
            </Grid>

            <!-- Microphone Area -->
            <Frame BackgroundColor="#e8f5e9" CornerRadius="100" WidthRequest="200" HeightRequest="200" 
                   HorizontalOptions="Center" HasShadow="False" BorderColor="Transparent" Margin="0,30,0,10">
                <Frame BackgroundColor="#0f8d39" CornerRadius="75" WidthRequest="150" HeightRequest="150" 
                       HorizontalOptions="Center" VerticalOptions="Center" HasShadow="True" BorderColor="Transparent">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartListeningCommand}" />
                    </Frame.GestureRecognizers>
                    <Label Text="🎤" FontSize="60" HorizontalOptions="Center" VerticalOptions="Center" />
                </Frame>
            </Frame>

            <Label Text="{Binding RecognizedText}" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="#2c2c2c" />
            <Label Text="Example: &quot;500 rupay khaad kharidi&quot;" HorizontalOptions="Center" FontSize="12" TextColor="#888" IsVisible="{Binding HasResult, Converter={x:StaticResource InvertedBoolConverter}}" />

            <!-- Result Box -->
            <Frame BorderColor="#e0e0e0" CornerRadius="12" Padding="15" HasShadow="False" BackgroundColor="White" IsVisible="{Binding HasResult}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Recent Voice Entry" FontAttributes="Bold" FontSize="14" TextColor="#2c2c2c" />
                    
                    <Frame Padding="10" CornerRadius="8" BorderColor="#e0e0e0" HasShadow="False">
                        <Label Text="{Binding RecognizedText, StringFormat='&quot;{0}&quot;'}" TextColor="#2c2c2c" FontSize="14" />
                    </Frame>

                    <Frame BackgroundColor="#f0fdf4" CornerRadius="8" Padding="15" BorderColor="Transparent" HasShadow="False" Margin="0,10,0,0">
                        <VerticalStackLayout Spacing="5">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="AI Response" FontAttributes="Bold" FontSize="14" TextColor="#2c2c2c" />
                                <Label Text="✅" FontSize="14" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding AiResponseText}" TextColor="#2c2c2c" FontSize="14" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <!-- Add Another -->
            <Button Text="Add Another Entry" Command="{Binding AddAnotherCommand}" IsVisible="{Binding HasResult}"
                    BackgroundColor="#0f8d39" TextColor="White" FontAttributes="Bold"
                    CornerRadius="12" HeightRequest="50" Margin="0,20,0,20" />
                    
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0f8d39" HorizontalOptions="Center" />
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
