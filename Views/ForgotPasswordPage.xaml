<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KrishiAI.App.Views.ForgotPasswordPage"
             Title="Reset Password"
             BackgroundColor="{StaticResource Primary}">

    <ScrollView>
        <VerticalStackLayout 
            Padding="20"
            Spacing="15"
            VerticalOptions="StartAndExpand">

            <!-- Header -->
            <Label 
                Text="🔐 Reset Password"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="White"
                Margin="0,20,0,10" />

            <Label 
                Text="Enter your email to reset your password"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="White"
                Opacity="0.9"
                Margin="0,0,0,20" />

            <!-- Card Container -->
            <Frame 
                CornerRadius="20"
                HasShadow="True"
                Padding="20"
                BackgroundColor="White">

                <VerticalStackLayout Spacing="12">

                    <!-- Email Entry -->
                    <Label 
                        Text="Email Address"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}" />

                    <Entry 
                        x:Name="EmailEntry"
                        Placeholder="Enter your registered email"
                        PlaceholderColor="#CCCCCC"
                        Text="{Binding Email}"
                        Keyboard="Email"
                        ReturnType="Next"
                        ClearButtonVisibility="WhileEditing"
                        Margin="0,0,0,5" />

                    <!-- New Password Entry -->
                    <Label 
                        Text="New Password"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        Margin="0,15,0,0" />

                    <Entry 
                        x:Name="NewPasswordEntry"
                        Placeholder="Enter new password (min 6 characters)"
                        PlaceholderColor="#CCCCCC"
                        Text="{Binding NewPassword}"
                        IsPassword="True"
                        ReturnType="Next"
                        Margin="0,0,0,5" />

                    <!-- Confirm Password Entry -->
                    <Label 
                        Text="Confirm Password"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        Margin="0,10,0,0" />

                    <Entry 
                        x:Name="ConfirmPasswordEntry"
                        Placeholder="Confirm new password"
                        PlaceholderColor="#CCCCCC"
                        Text="{Binding ConfirmNewPassword}"
                        IsPassword="True"
                        ReturnType="Go"
                        Margin="0,0,0,5" />

                    <!-- Error Message -->
                    <Label 
                        Text="{Binding ErrorMessage}"
                        FontSize="12"
                        TextColor="{StaticResource Error}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        Margin="0,10,0,5"
                        Padding="10"
                        BackgroundColor="#FFEBEE" />

                    <!-- Success Message -->
                    <Label 
                        Text="{Binding SuccessMessage}"
                        FontSize="12"
                        TextColor="#4CAF50"
                        IsVisible="{Binding SuccessMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        Margin="0,10,0,5"
                        Padding="10"
                        BackgroundColor="#E8F5E9" />

                    <!-- Reset Button -->
                    <Button 
                        Text="Reset Password"
                        Command="{Binding ResetPasswordCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,15,0,10"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <!-- Back to Login Link -->
                    <Label 
                        Text="Back to Login"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center"
                        Margin="0,10,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding NavigateToLoginCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Loading Indicator -->
                    <ActivityIndicator 
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource Primary}"
                        Scale="1.5"
                        Margin="0,10,0,0" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
