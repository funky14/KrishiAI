<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header with Greeting and Notification -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="{Binding Greeting, StringFormat='{0},'}" 
                           FontSize="16" 
                           TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{Binding Farmer, StringFormat='{0}!'}" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextPrimary}"/>
                </VerticalStackLayout>

                <Frame Grid.Column="1" 
                       WidthRequest="50" 
                       HeightRequest="50"
                       CornerRadius="25"
                       Padding="0"
                       BackgroundColor="White"
                       BorderColor="{StaticResource Primary}"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToNotificationsCommand}"/>
                    </Frame.GestureRecognizers>
                    <Grid>
                        <!-- Bell Icon -->
                        <Label Text="🔔" 
                               FontSize="26"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="0,2,0,0"/>

                        <!-- Notification Badge -->
                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource Error}"
                                WidthRequest="22" 
                                HeightRequest="22"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,-3,-3,0"
                                Stroke="White"
                                StrokeThickness="2"
                                IsVisible="{Binding HasNotifications}">
                            <Label Text="{Binding NotificationCount}" 
                                   FontSize="11"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   Margin="0,1,0,0"/>
                        </Border>
                    </Grid>
                </Frame>
            </Grid>

            <!-- KrishiAI Banner -->
            <Frame CornerRadius="15" BackgroundColor="{StaticResource Primary}" Padding="20" HasShadow="True">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <Label Grid.Row="0" 
                           Grid.Column="0"
                           Text="{Binding KrishiAI}" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           TextColor="White"/>
                    <Label Grid.Row="1" 
                           Grid.Column="0"
                           Grid.RowSpan="2"
                           Text="{Binding YourAIFarmingCompanion}" 
                           FontSize="18" 
                           TextColor="White"/>
                    <BoxView Grid.Row="0" 
                             Grid.RowSpan="3"
                             Grid.Column="1"
                             WidthRequest="100"
                             HeightRequest="100"
                             CornerRadius="50"
                             BackgroundColor="#FFA726"
                             HorizontalOptions="End"
                             VerticalOptions="Center"
                             Margin="10,0,0,0"/>
                    <Label Grid.Row="0" 
                           Grid.RowSpan="3"
                           Grid.Column="1"
                           Text="🌾"
                           FontSize="60"
                           HorizontalOptions="End"
                           VerticalOptions="Center"
                           Margin="10,0,20,0"/>
                </Grid>
            </Frame>

            <!-- Smart Farming for Better Tomorrow -->
            <Label Text="{Binding SmartFarming}" 
                   FontSize="14" 
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Start"
                   Margin="5,0,0,0"/>
            <Label Text="{Binding BetterTomorrow}" 
                   FontSize="14" 
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Start"
                   Margin="5,-15,0,0"/>

            <!-- How can I help you today? -->
            <Label Text="{Binding HowCanIHelp}" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"/>

            <!-- Crop Disease Detection Card -->
            <Frame CornerRadius="15" Padding="20" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="Auto,*">
                        <Frame Grid.Column="0"
                               WidthRequest="40"
                               HeightRequest="40"
                               CornerRadius="20"
                               Padding="0"
                               BackgroundColor="#E8F5E9"
                               HasShadow="False">
                            <Label Text="🌿" 
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <Label Grid.Column="1"
                               Text="{Binding CropDiseaseDetection}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center"
                               Margin="10,0,0,0"
                               TextColor="{StaticResource Primary}"/>
                    </Grid>
                    <Label Text="{Binding CropDiseaseDescriptionText}" 
                           FontSize="14" 
                           TextColor="{StaticResource TextSecondary}"/>
                    <Button Text="{Binding DetectDisease}"
                            Command="{Binding NavigateToDiseaseDetectionCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="50"
                            FontSize="16"
                            CornerRadius="10"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Voice Assistant Card -->
            <Frame CornerRadius="15" Padding="20" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="15">
                    <Grid ColumnDefinitions="Auto,*">
                        <Frame Grid.Column="0"
                               WidthRequest="40"
                               HeightRequest="40"
                               CornerRadius="20"
                               Padding="0"
                               BackgroundColor="#E3F2FD"
                               HasShadow="False">
                            <Label Text="🎤" 
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <Label Grid.Column="1"
                               Text="{Binding VoiceAssistant}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center"
                               Margin="10,0,0,0"
                               TextColor="{StaticResource Accent}"/>
                    </Grid>
                    <Label Text="{Binding VoiceAssistantDescriptionText}" 
                           FontSize="14" 
                           TextColor="{StaticResource TextSecondary}"/>
                    <Button Text="{Binding AskQuestion}"
                            Command="{Binding NavigateToVoiceAssistantCommand}"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="White"
                            HeightRequest="50"
                            FontSize="16"
                            CornerRadius="10"/>
                </VerticalStackLayout>
            </Frame>


            <!-- Quick Features -->
            <Label Text="{Binding QuickFeatures}" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}"
                   Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <!-- 7 Languages -->
                <Frame Grid.Column="0" 
                       CornerRadius="10" 
                       Padding="10" 
                       BackgroundColor="White"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLanguagesCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🌐" FontSize="28" HorizontalOptions="Center"/>
                        <Label Text="{Binding Languages}" FontSize="12" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- History -->
                <Frame Grid.Column="1" 
                       CornerRadius="10" 
                       Padding="10" 
                       BackgroundColor="White"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToHistoryCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="📜" FontSize="28" HorizontalOptions="Center"/>
                        <Label Text="{Binding History}" FontSize="12" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Farming Tips -->
                <Frame Grid.Column="2" 
                       CornerRadius="10" 
                       Padding="10" 
                       BackgroundColor="White"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFarmerTipsCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="💡" FontSize="28" HorizontalOptions="Center"/>
                        <Label Text="{Binding FarmingTips}" FontSize="12" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
