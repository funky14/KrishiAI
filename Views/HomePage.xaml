<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- App Header -->
            <Frame CornerRadius="15" BackgroundColor="{StaticResource Primary}" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🌾 KrishiAI" 
                           FontSize="32" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           HorizontalOptions="Center"/>
                    <Label Text="Your Smart Farming Assistant" 
                           FontSize="16" 
                           TextColor="White" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Welcome Message -->
            <Label Text="Welcome, Farmer!" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}"/>
            
            <Label Text="How can I help you today?" 
                   FontSize="16" 
                   TextColor="{StaticResource TextSecondary}"/>

            <!-- Feature Cards -->
            <Frame CornerRadius="15" Padding="20" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🔬 Crop Disease Detection" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Primary}"/>
                    <Label Text="Take a photo of your crop and get instant disease identification with treatment recommendations" 
                           FontSize="14" 
                           TextColor="{StaticResource TextSecondary}"/>
                    <Button Text="Detect Disease" 
                            Command="{Binding NavigateToDiseaseDetectionCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            HeightRequest="60"
                            FontSize="18"
                            CornerRadius="10"/>
                </VerticalStackLayout>
            </Frame>

            <Frame CornerRadius="15" Padding="20" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="🎤 Voice Assistant" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource Accent}"/>
                    <Label Text="Ask farming questions in your language and get AI-powered advice" 
                           FontSize="14" 
                           TextColor="{StaticResource TextSecondary}"/>
                    <Button Text="Ask a Question" 
                            Command="{Binding NavigateToVoiceAssistantCommand}"
                            BackgroundColor="{StaticResource Accent}"
                            TextColor="White"
                            HeightRequest="60"
                            FontSize="18"
                            CornerRadius="10"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Stats -->
            <Label Text="Quick Features" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{StaticResource TextPrimary}"
                   Margin="0,10,0,0"/>
            
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" CornerRadius="10" Padding="15" BackgroundColor="{StaticResource Success}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="✓" FontSize="30" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="Offline AI" FontSize="14" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold"/>
                        <Label Text="Works without internet" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
                
                <Frame Grid.Column="1" CornerRadius="10" Padding="15" BackgroundColor="{StaticResource Secondary}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🌐" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="7 Languages" FontSize="14" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold"/>
                        <Label Text="Speak your language" FontSize="11" TextColor="White" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
