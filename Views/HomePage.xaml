<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             BackgroundColor="#E8F5E9"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header with Greeting -->
            <VerticalStackLayout Margin="0,10,0,0">
                <Label Text="{Binding GreetingText}" 
                       FontSize="14" 
                       TextColor="#666666"/>
                <Label Text="{Binding CurrentUserName}" 
                       FontSize="32" 
                       FontAttributes="Bold"
                       TextColor="#2E7D32"/>
            </VerticalStackLayout>

            <!-- Hero Banner -->
            <Frame BackgroundColor="#4CAF50" 
                   BorderColor="Transparent" 
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True"
                   HeightRequest="120">
                <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                    <Label Text="{Binding PlantHealthMonitorText}" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="{Binding PlantHealthMonitorDescText}" 
                           FontSize="14"
                           TextColor="White"
                           Opacity="0.9"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Help Text -->
            <Label Text="{Binding HowCanIHelpYouText}" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="#333333"
                   Margin="0,10,0,0"/>

            <!-- Feature Card: Crop Disease Detection -->
            <Frame BackgroundColor="White" 
                   BorderColor="#E0E0E0" 
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding CropDiseaseDetectionTitleText}" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="#2E7D32"/>
                    <Label Text="{Binding CropDiseaseDetectionDescText}" 
                           FontSize="14"
                           TextColor="#666666"
                           LineBreakMode="WordWrap"/>
                    <Button Text="{Binding DetectDiseaseText}" 
                            Command="{Binding NavigateToDiseaseDetectionCommand}"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            FontAttributes="Bold"
                            Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Feature Card: Voice Assistant -->
            <Frame BackgroundColor="White" 
                   BorderColor="#E0E0E0" 
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding VoiceAssistantTitleText}" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="#1976D2"/>
                    <Label Text="{Binding VoiceAssistantDescText}" 
                           FontSize="14"
                           TextColor="#666666"
                           LineBreakMode="WordWrap"/>
                    <Button Text="{Binding AskAQuestionText}" 
                            Command="{Binding NavigateToVoiceAssistantCommand}"
                            BackgroundColor="#2196F3"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="45"
                            FontAttributes="Bold"
                            Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Features -->
            <Label Text="{Binding QuickFeaturesText}" 
                   FontSize="16" 
                   FontAttributes="Bold"
                   TextColor="#333333"
                   Margin="0,10,0,5"/>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Frame Grid.Column="0" 
                       BackgroundColor="White"
                       BorderColor="Transparent"
                       CornerRadius="10"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="🌐" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="{Binding LanguagesText}" 
                               FontSize="12" 
                               TextColor="#666666"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" 
                       BackgroundColor="White"
                       BorderColor="Transparent"
                       CornerRadius="10"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="📊" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="{Binding HistoryText}" 
                               FontSize="12" 
                               TextColor="#666666"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="2" 
                       BackgroundColor="White"
                       BorderColor="Transparent"
                       CornerRadius="10"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                        <Label Text="💡" FontSize="30" HorizontalOptions="Center"/>
                        <Label Text="{Binding FarmingTipsText}" 
                               FontSize="12" 
                               TextColor="#666666"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
