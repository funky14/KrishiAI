<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:weather="clr-namespace:KrishiAI.App.Models.Weather"
             x:Class="KrishiAI.App.Views.WeatherDashboardPage"
             x:DataType="viewmodels:WeatherDashboardViewModel"
             BackgroundColor="#F5F5F5"
             Title="{Binding Title, Mode=OneWay}">

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshWeatherCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Header: KrishiAI Title -->
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="KrishiAI"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#4CAF50"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="🔔"
                           FontSize="28"
                           VerticalOptions="Center"/>
                    <BoxView Grid.Column="2"
                             WidthRequest="40"
                             HeightRequest="40"
                             CornerRadius="4"
                             Color="#CCCCCC"
                             VerticalOptions="Center"/>
                </Grid>

                <!-- Weather & Irrigation Header -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding WeatherAndIrrigationText}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#1B5E20"/>
                    <Label Text="{Binding LocationName}"
                           FontSize="14"
                           TextColor="#666"
                           Margin="0,-4,0,0"/>
                    <Label Text="{Binding RadiusText}"
                           FontSize="12"
                           TextColor="#999"/>
                </VerticalStackLayout>

                <!-- Current Weather Card -->
                <Frame BackgroundColor="White"
                       Padding="20"
                       CornerRadius="16"
                       HasShadow="True"
                       IsVisible="{Binding HasWeatherData}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <!-- Left side: Temperature and description -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8">
                            <Label Text="{Binding TodayWeather.Temperature, StringFormat='{0:F0}°C'}"
                                   FontSize="48"
                                   FontAttributes="Bold"
                                   TextColor="#333"
                                   LineBreakMode="NoWrap"/>
                            <Label Text="{Binding TodayWeather.Description}"
                                   FontSize="14"
                                   TextColor="#666"/>
                        </VerticalStackLayout>

                        <!-- Right side: Weather Icon -->
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding TodayWeather.Icon}"
                               FontSize="64"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>

                        <!-- Weather Details Grid -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              ColumnDefinitions="*,*,*" ColumnSpacing="16" RowSpacing="12"
                              Margin="0,12,0,0">
                            <!-- Humidity -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding HumidityLabel}"
                                       FontSize="11"
                                       TextColor="#999"/>
                                <Label Text="{Binding TodayWeather.Humidity, StringFormat='{0}%'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#333"/>
                            </VerticalStackLayout>

                            <!-- Wind Speed -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding WindLabel}"
                                       FontSize="11"
                                       TextColor="#999"/>
                                <Label Text="{Binding TodayWeather.WindSpeed, StringFormat='{0:F0} km/h'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#333"/>
                            </VerticalStackLayout>

                            <!-- Feels Like -->
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="{Binding FeelsLikeLabel}"
                                       FontSize="11"
                                       TextColor="#999"/>
                                <Label Text="{Binding TodayWeather.FeelsLike, StringFormat='{0:F0}°C'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#333"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Frame>

                <!-- 7-Day Forecast Card -->
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding SevenDayForecastText}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#1B5E20"
                               VerticalOptions="Center"/>
                        <Label
                            Text="{Binding ViewAllText}"
                            FontSize="14"
                            TextColor="#4CAF50"
                            VerticalOptions="Center"
                            HorizontalOptions="EndAndExpand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllCommand}" CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <CollectionView ItemsSource="{Binding WeeklyForecast}"
                                    SelectionMode="None"
                                    HeightRequest="120">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal"
                                               ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="weather:DailyForecast">
                                <Frame BackgroundColor="White"
                                       Padding="12"
                                       CornerRadius="12"
                                       HasShadow="True"
                                       WidthRequest="90">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="{Binding Date, StringFormat='{0:ddd}'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#333"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding Icon}"
                                               FontSize="28"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding TemperatureMax, StringFormat='{0:F0}°'}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#333"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding TemperatureMin, StringFormat='{0:F0}°'}"
                                               FontSize="11"
                                               TextColor="#999"
                                               HorizontalOptions="Center"/>
                                        <Label Text="{Binding Rainfall, StringFormat='{0:F0}%'}"
                                               FontSize="11"
                                               TextColor="#666"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- AI Irrigation Advisor Card -->
                <Frame BackgroundColor="White"
                       Padding="16"
                       CornerRadius="16"
                       HasShadow="True"
                       IsVisible="{Binding LatestRecommendation, Converter={StaticResource IsNotNullConverter}}">
                    <VerticalStackLayout Spacing="12">
                        <!-- Header with title and recommended badge -->
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="💧"
                                   FontSize="24"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding IrrigationAdvisorText}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#1B5E20"/>
                            </VerticalStackLayout>
                            <Frame BackgroundColor="#4CAF50"
                                   Padding="8,4"
                                   CornerRadius="12"
                                   HasShadow="True"
                                   HorizontalOptions="EndAndExpand"
                                   VerticalOptions="Center">
                                <Label Text="{Binding RecommendedText}"
                                       FontSize="11"
                                       TextColor="White"
                                       FontAttributes="Bold"/>
                            </Frame>
                        </HorizontalStackLayout>

                        <!-- Irrigation Description -->
                        <Label Text="{Binding IrrigationDescriptionText}"
                               FontSize="14"
                               TextColor="#333"
                               LineBreakMode="WordWrap"/>
                        <Label Text="for 2 hours"
                               FontSize="13"
                               TextColor="#666"/>

                        <!-- Crop Details Grid -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="8" Margin="0,8,0,0">
                            <!-- Crop -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding CropLabel}"
                                       FontSize="11"
                                       TextColor="#999"/>
                                <Label Text="{Binding ActiveCrop.DisplayName}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#333"/>
                            </VerticalStackLayout>

                            <!-- Growth Stage -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding GrowthStageLabel}"
                                       FontSize="11"
                                       TextColor="#999"/>
                                <Label Text="{Binding ActiveCropGrowthStageDisplay}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#333"/>
                            </VerticalStackLayout>

                            <!-- Soil Moisture -->
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="{Binding SoilMoistureLabel}"
                                       FontSize="11"
                                       TextColor="#999"/>
                                <Label Text="Low (28%)"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#333"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- View Irrigation Plan Button -->
                        <Button Text="{Binding ViewIrrigationPlanText}"
                                Command="{Binding NavigateToIrrigationAdvisorCommand}"
                                BackgroundColor="#4CAF50"
                                TextColor="White"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                Padding="12,8"
                                Margin="0,8,0,0"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Loading Indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#4CAF50"
                                   HeightRequest="50"/>

                <!-- Error Message -->
                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                       TextColor="#D32F2F"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       Margin="0,12"/>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
