<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:models="clr-namespace:KrishiAI.App.Models"
             x:Class="KrishiAI.App.Views.HistoryPage"
             x:DataType="viewmodels:HistoryViewModel"
             Title="Detection History"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Detection History" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   Margin="0,10,0,10"/>

            <!-- Sync Status (Phase 4) -->
            <Frame BackgroundColor="#FFF3E0" 
                   BorderColor="#FFB74D"
                   CornerRadius="10"
                   Padding="12,8"
                   IsVisible="{Binding IsSyncing}">
                <Label Text="🔄 Syncing detection history..." 
                       FontSize="13"
                       TextColor="#E65100"
                       FontAttributes="Bold"/>
            </Frame>

            <!-- History Cover -->
            <Frame BackgroundColor="#4CAF50" 
                   BorderColor="Transparent" 
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📊 Your Detection Records" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="Track all your crop disease detections" 
                           FontSize="14"
                           TextColor="White"
                           Opacity="0.9"/>
                </VerticalStackLayout>
            </Frame>

            <!-- History List -->
            <!-- Empty State -->
            <VerticalStackLayout IsVisible="{Binding HasHistory, Converter={StaticResource InvertedBoolConverter}}"
                               Spacing="20" 
                               Margin="0,30,0,0">
                <Label Text="📋" FontSize="80" HorizontalOptions="Center" Opacity="0.5"/>
                <Label Text="No history yet" 
                       FontSize="20" 
                       TextColor="#666666" 
                       HorizontalOptions="Center"/>
                <Label Text="Start analyzing crops to see history here" 
                       FontSize="14" 
                       TextColor="#999999" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- History Items -->
            <CollectionView ItemsSource="{Binding HistoryItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiseaseDetectionResult">
                        <Frame CornerRadius="15" 
                               Padding="15" 
                               BackgroundColor="White" 
                               BorderColor="#E0E0E0"
                               Margin="0,5"
                               HasShadow="True">
                            <Grid ColumnDefinitions="100,*,80" ColumnSpacing="15">
                                
                                <!-- Image Thumbnail -->
                                <Image Grid.Column="0" 
                                       Source="{Binding ImagePath}" 
                                       Aspect="AspectFill"
                                       HeightRequest="100"
                                       WidthRequest="100">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="10" Rect="0,0,100,100"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding DiseaseName}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="#D32F2F"/>
                                    <Label Text="{Binding Confidence, StringFormat='Confidence {0:F1}%'}" 
                                           FontSize="14" 
                                           TextColor="#666666"/>
                                    <Frame BackgroundColor="#FFF3E0" 
                                           BorderColor="Transparent"
                                           CornerRadius="5" 
                                           Padding="6,3" 
                                           HorizontalOptions="Start">
                                        <Label Text="{Binding Severity, StringFormat='{0} Severity'}" 
                                               FontSize="11" 
                                               TextColor="#F57C00" 
                                               FontAttributes="Bold"/>
                                    </Frame>
                                    <Label Text="{Binding DetectedDate, StringFormat='{0:MMM dd, yyyy HH:mm}'}" 
                                           FontSize="12" 
                                           TextColor="#999999"/>

                                    <!-- Device Info Badge -->
                                    <Frame BackgroundColor="#E3F2FD" 
                                           BorderColor="Transparent"
                                           CornerRadius="5" 
                                           Padding="6,3" 
                                           HorizontalOptions="Start"
                                           IsVisible="{Binding DeviceName, Converter={StaticResource StringNotEmptyConverter}}">
                                        <Label Text="{Binding DeviceName, StringFormat='📱 {0}'}" 
                                               FontSize="10" 
                                               TextColor="#1976D2" 
                                               FontAttributes="Bold"/>
                                    </Frame>
                                </VerticalStackLayout>

                                <!-- Sync Status Badge (Phase 4) -->
                                <VerticalStackLayout Grid.Column="2" 
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Center"
                                                   Spacing="5">
                                    <!-- Synced -->
                                    <Frame BackgroundColor="#E8F5E9" 
                                           BorderColor="Transparent"
                                           CornerRadius="8" 
                                           Padding="8,4"
                                           IsVisible="{Binding IsSynced}">
                                        <Label Text="✓ Synced" 
                                               FontSize="11" 
                                               TextColor="#2E7D32" 
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                    </Frame>
                                    
                                    <!-- Pending -->
                                    <Frame BackgroundColor="#FFF3E0" 
                                           BorderColor="Transparent"
                                           CornerRadius="8" 
                                           Padding="8,4"
                                           IsVisible="{Binding IsSynced, Converter={StaticResource InvertedBoolConverter}}">
                                        <Label Text="⏳ Pending" 
                                               FontSize="11" 
                                               TextColor="#F57C00" 
                                               FontAttributes="Bold"
                                               HorizontalOptions="Center"/>
                                    </Frame>
                                    
                                    <!-- Delete Button -->
                                    <Button Text="🗑️" 
                                            FontSize="16"
                                            BackgroundColor="Transparent"
                                            TextColor="#F44336"
                                            Padding="0"
                                            CornerRadius="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HistoryViewModel}}, Path=DeleteItemCommand}"
                                            CommandParameter="{Binding .}"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Bottom Actions -->
            <Button Text="🔄 Refresh"
                  Command="{Binding RefreshCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    HeightRequest="50"
                    FontSize="16"
                    CornerRadius="10"
                    IsVisible="{Binding HasHistory}"
                    Margin="0,10,0,0"/>
            
            <Button Text="🗑️ Clear All History"
                    Command="{Binding ClearAllHistoryCommand}"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    HeightRequest="50"
                    FontSize="16"
                    CornerRadius="10"
                    IsVisible="{Binding HasHistory}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
