<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:models="clr-namespace:KrishiAI.App.Models"
             x:Class="KrishiAI.App.Views.HistoryPage"
             x:DataType="viewmodels:HistoryViewModel"
             Title="{Binding DetectionHistoryText}"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="{Binding DetectionHistoryText}" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   Margin="0,10,0,10"/>

            <!-- Sync Status (Phase 4) -->
            <Frame BackgroundColor="#FFF3E0" 
                   BorderColor="#FFB74D"
                   CornerRadius="10"
                   Padding="12,8"
                   IsVisible="{Binding IsSyncing}">
                <Label Text="{Binding SyncingDetectionHistoryText}" 
                       FontSize="13"
                       TextColor="#E65100"
                       FontAttributes="Bold"/>
            </Frame>

            <!-- History Cover -->
            <Frame BackgroundColor="#4CAF50" 
                   BorderColor="Transparent" 
                   CornerRadius="15"
                   Padding="20"
                   HasShadow="True">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding YourDetectionRecordsText}" 
                           FontSize="20" 
                           FontAttributes="Bold"
                           TextColor="White"/>
                    <Label Text="{Binding TrackAllYourCropDiseaseDetectionsText}" 
                           FontSize="14"
                           TextColor="White"
                           Opacity="0.9"/>
                </VerticalStackLayout>
            </Frame>

            <!-- History List -->
            <!-- Empty State -->
            <VerticalStackLayout IsVisible="{Binding HasHistory, Converter={StaticResource InvertedBoolConverter}}"
                               Spacing="20" 
                               Margin="0,30,0,0">
                <Label Text="📋" FontSize="80" HorizontalOptions="Center" Opacity="0.5"/>
                <Label Text="{Binding NoHistoryYetText}" 
                       FontSize="20" 
                       TextColor="#666666" 
                       HorizontalOptions="Center"/>
                <Label Text="{Binding StartAnalyzingCropsToSeeHistoryHereText}" 
                       FontSize="14" 
                       TextColor="#999999" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- History Items -->
            <CollectionView ItemsSource="{Binding HistoryItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DiseaseDetectionResult">
                        <Frame CornerRadius="15" 
                               Padding="15" 
                               BackgroundColor="White" 
                               BorderColor="#E0E0E0"
                               Margin="0,5"
                               HasShadow="True">
                            <Grid ColumnDefinitions="100,*,80" ColumnSpacing="15">

                                <!-- Image Thumbnail -->
                                <Image Grid.Column="0" 
                                       Source="{Binding ImagePath}" 
                                       Aspect="AspectFill"
                                       HeightRequest="100"
                                       WidthRequest="100">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="10" Rect="0,0,100,100"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Details -->
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding DiseaseName}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           TextColor="#D32F2F"/>
                                    <Label Text="{Binding Confidence, StringFormat='Confidence {0:F1}%'}" 
                                           FontSize="14" 
                                           TextColor="#666666"/>
                                    <Frame BackgroundColor="#FFF3E0" 
                                           BorderColor="Transparent"
                                           CornerRadius="5" 
                                           Padding="6,3" 
                                           HorizontalOptions="Start">
                                        <Label Text="{Binding Severity}" 
                                               FontSize="11" 
                                               FontAttributes="Bold" 
                                               TextColor="#F57C00"/>
                                    </Frame>
                                    <Label Text="{Binding DetectedDate, StringFormat='{0:MMM dd, yyyy}'}" 
                                           FontSize="12" 
                                           TextColor="#999999"/>
                                </VerticalStackLayout>

                                <!-- Actions -->
                                <VerticalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                    <Border BackgroundColor="#4CAF50" 
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10">
                                        <Label Text="👁️" FontSize="20" HorizontalOptions="Center"/>
                                    </Border>
                                    <Border BackgroundColor="#F44336" 
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="10">
                                        <Label Text="🗑️" FontSize="20" HorizontalOptions="Center"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
