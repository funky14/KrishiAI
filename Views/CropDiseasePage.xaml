<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.CropDiseasePage"
             x:DataType="viewmodels:CropDiseaseViewModel"
             Title="Crop Disease Detection"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Crop Disease Detection" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   Margin="0,10,0,10"/>

            <!-- Camera Card -->
            <Frame BackgroundColor="White" 
                   BorderColor="#E0E0E0" 
                   CornerRadius="15"
                   Padding="0" 
                   HasShadow="True"
                   HeightRequest="300">
                <Grid>
                    <!-- Placeholder when no image -->
                    <VerticalStackLayout IsVisible="{Binding HasImage, Converter={StaticResource InvertedBoolConverter}}"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center" 
                                       Spacing="15">
                        <Label Text="📷" FontSize="80" HorizontalOptions="Center"/>
                        <Label Text="Tap to capture or select" 
                               FontSize="16" 
                               TextColor="#666666" 
                               HorizontalOptions="Center"/>
                        <Label Text="a crop image" 
                               FontSize="16" 
                               TextColor="#666666" 
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Image Display -->
                    <Image Source="{Binding SelectedImagePath}" 
                           IsVisible="{Binding HasImage}"
                           Aspect="AspectFill"/>
                </Grid>
            </Frame>

            <!-- Action Buttons -->
            <VerticalStackLayout Spacing="12">
                <Button Text="📷 Capture Photo"
                        Command="{Binding CapturePhotoCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        CornerRadius="10"/>
                
                <Button Text="🖼️ Choose from Gallery"
                        Command="{Binding PickPhotoCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        CornerRadius="10"/>
                
                <Button Text="🔍 Analyze Disease"
                        Command="{Binding AnalyzeImageCommand}"
                        IsEnabled="{Binding HasImage}"
                        BackgroundColor="#FF9800"
                        TextColor="White"
                        HeightRequest="55"
                        FontSize="18"
                        FontAttributes="Bold"
                        CornerRadius="10"/>
            </VerticalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsAnalyzing}"
                             IsVisible="{Binding IsAnalyzing}"
                             Color="#4CAF50"
                             HeightRequest="50"/>

            <Label Text="Analyzing crop image..."
                   IsVisible="{Binding IsAnalyzing}"
                   FontSize="16"
                   TextColor="#4CAF50"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Results Section -->
            <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="15">
                
                <!-- Diagnosis Header -->
                <Label Text="🛡️ Diagnosis" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       TextColor="#666666"
                       Margin="0,10,0,0"/>

                <!-- Disease Name and Confidence -->
                <Frame BackgroundColor="White" 
                       BorderColor="#E0E0E0"
                       CornerRadius="15" 
                       Padding="20"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding DetectionResult.DiseaseName}" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               TextColor="#D32F2F"/>
                        <Label Text="{Binding DetectionResult.Confidence, StringFormat='Confidence {0:F1}%'}" 
                               FontSize="16" 
                               TextColor="#666666"/>
                        <Frame BackgroundColor="#FFF3E0" 
                               BorderColor="Transparent"
                               CornerRadius="5" 
                               Padding="8,4" 
                               HorizontalOptions="Start"
                               Margin="0,5,0,0">
                            <Label Text="{Binding DetectionResult.Severity, StringFormat='{0} Severity'}" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   TextColor="#F57C00"/>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Organic Treatment -->
                <Frame BackgroundColor="White" 
                       BorderColor="#E0E0E0"
                       CornerRadius="15" 
                       Padding="20"
                       HasShadow="True"
                       IsVisible="{Binding Recommendation, Converter={StaticResource NotNullConverter}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="🌿 Organic Treatment" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#2E7D32"/>
                        <CollectionView ItemsSource="{Binding Recommendation.OrganicTreatment}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding ., StringFormat='• {0}'}" 
                                           TextColor="#666666" 
                                           FontSize="14" 
                                           Margin="5,2"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- Prevention Tips -->
                <Frame BackgroundColor="White" 
                       BorderColor="#E0E0E0"
                       CornerRadius="15" 
                       Padding="20"
                       HasShadow="True"
                       IsVisible="{Binding Recommendation, Converter={StaticResource NotNullConverter}}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="✓ Prevention Tips" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="#1976D2"/>
                        <CollectionView ItemsSource="{Binding Recommendation.PreventionTips}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding ., StringFormat='• {0}'}" 
                                           TextColor="#666666" 
                                           FontSize="14" 
                                           Margin="5,2"/>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <!-- New Analysis Button -->
                <Button Text="New Analysis"
                        Command="{Binding ClearResultCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Margin="0,10,0,0"/>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
