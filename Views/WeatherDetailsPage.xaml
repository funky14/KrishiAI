<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:weather="clr-namespace:KrishiAI.App.Models.Weather"
             x:Class="KrishiAI.App.Views.WeatherDetailsPage"
             x:DataType="vm:WeatherDashboardViewModel"
             BackgroundColor="#F5F5F5"
             Title="{Binding WeatherAndIrrigationText}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="{Binding LocationName}" FontSize="16" TextColor="#333" />
            <HorizontalStackLayout Spacing="12">
                <Frame BackgroundColor="White" CornerRadius="12" Padding="12" HasShadow="True">
                    <VerticalStackLayout>
                        <Label Text="{Binding TodayWeather.Temperature, StringFormat='{0:F0}°C'}" FontSize="36" FontAttributes="Bold" />
                        <Label Text="{Binding TodayWeather.Description}" FontSize="14" TextColor="#666" />
                    </VerticalStackLayout>
                </Frame>
                <VerticalStackLayout Spacing="8" HorizontalOptions="FillAndExpand">
                    <Frame BackgroundColor="White" CornerRadius="12" Padding="12" HasShadow="True">
                        <VerticalStackLayout>
                            <Label Text="{Binding HumidityLabel}" FontSize="12" TextColor="#999" />
                            <Label Text="{Binding TodayWeather.Humidity, StringFormat='{0}%'}" FontSize="16" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame BackgroundColor="White" CornerRadius="12" Padding="12" HasShadow="True">
                        <VerticalStackLayout>
                            <Label Text="{Binding WindLabel}" FontSize="12" TextColor="#999" />
                            <Label Text="{Binding TodayWeather.WindSpeed, StringFormat='{0:F0} km/h'}" FontSize="16" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Frame>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Label Text="{Binding SevenDayForecastText}" FontSize="18" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding WeeklyForecast}" HeightRequest="120">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="weather:DailyForecast">
                        <Frame BackgroundColor="White" CornerRadius="12" Padding="10" HasShadow="True" WidthRequest="90">
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding Date, StringFormat='{0:ddd}'}" FontSize="12" />
                                <Label Text="{Binding Icon}" FontSize="20" />
                                <Label Text="{Binding TemperatureMax, StringFormat='{0:F0}°'}" FontSize="12" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>