<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:models="clr-namespace:KrishiAI.App.Models"
             x:Class="KrishiAI.App.Views.NotificationsPage"
             x:DataType="viewmodels:NotificationsViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Frame Grid.Row="0" CornerRadius="0" Padding="20" BackgroundColor="White" HasShadow="True">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label Grid.Column="0" Text="Notifications" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}"/>
                <Label Grid.Column="1" Text="{Binding NotificationCount, StringFormat='{0} alerts'}" FontSize="14" VerticalOptions="Center" HorizontalOptions="End" Margin="0,0,10,0" TextColor="{StaticResource TextSecondary}"/>
                <Button Grid.Column="2" Text="✕" FontSize="24" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" Command="{Binding CloseCommand}"/>
            </Grid>
        </Frame>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="10">
                <CollectionView ItemsSource="{Binding Notifications}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Notification">
                            <Frame Padding="15" Margin="0,5" CornerRadius="10" BackgroundColor="White" HasShadow="False" BorderColor="{StaticResource TextSecondary}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:NotificationsViewModel}}, Path=MarkAsReadCommand}" CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="15">
                                    <Frame Grid.Column="0" Grid.RowSpan="2" WidthRequest="50" HeightRequest="50" CornerRadius="25" Padding="0" BackgroundColor="{Binding IconColor}" HasShadow="False">
                                        <Label Text="{Binding Icon}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1" Grid.Row="0" Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Grid.Column="1" Grid.Row="1" Text="{Binding Message}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="2" Text="Clear Notifications" Command="{Binding ClearNotificationsCommand}" BackgroundColor="{StaticResource Error}" TextColor="White" Margin="20" HeightRequest="50" CornerRadius="10"/>
    </Grid>
</ContentPage>
