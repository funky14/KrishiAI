<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:irrigation="clr-namespace:KrishiAI.App.Models.Irrigation"
             x:Class="KrishiAI.App.Views.CropManagementPage"
             x:DataType="viewmodels:CropManagementViewModel"
             BackgroundColor="#E8F5E9"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Frame BackgroundColor="White" Padding="20" CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🌾 Add New Crop" FontSize="18" FontAttributes="Bold" TextColor="#2E7D32"/>

                    <Label Text="Crop Type" FontSize="14"/>
                    <Picker ItemsSource="{Binding AvailableCropTypes}" SelectedItem="{Binding SelectedCropType}"/>

                    <Label Text="Growth Stage" FontSize="14"/>
                    <Picker ItemsSource="{Binding AvailableGrowthStages}" SelectedItem="{Binding SelectedGrowthStage}"/>

                    <Label Text="Field Size (Acres)" FontSize="14"/>
                    <Entry Text="{Binding FieldSizeAcres}" Keyboard="Numeric"/>

                    <Button Text="Add Crop" Command="{Binding AddCropCommand}" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="8"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="White" Padding="20" CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🌱 My Crops" FontSize="18" FontAttributes="Bold" TextColor="#2E7D32"/>

                    <CollectionView ItemsSource="{Binding Crops}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="irrigation:CropInfo">
                                <Frame Padding="12" Margin="0,8" BackgroundColor="#F5F5F5" CornerRadius="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding Emoji}" FontSize="20"/>
                                                <Label Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                                                <Label Text="(Active)" IsVisible="{Binding IsActive}" TextColor="#4CAF50" FontSize="12" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding GrowthStage}" FontSize="12" TextColor="#666"/>
                                            <Label Text="{Binding PlantedDate, StringFormat='Planted: {0:MMM dd, yyyy}'}" FontSize="12" TextColor="#666"/>
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1" Text="Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CropManagementViewModel}}, Path=DeleteCropCommand}" CommandParameter="{Binding .}" BackgroundColor="#F44336" TextColor="White"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
