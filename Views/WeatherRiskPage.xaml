<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:risk="clr-namespace:KrishiAI.App.Models.Risk"
             x:Class="KrishiAI.App.Views.WeatherRiskPage"
             x:DataType="viewmodels:WeatherRiskViewModel"
             BackgroundColor="#E8F5E9"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Frame BackgroundColor="White" Padding="20" CornerRadius="12" HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="⚠️ Active Weather Risks" FontSize="20" FontAttributes="Bold" TextColor="#C62828"/>
                    <Label Text="{Binding TotalRisks, StringFormat='Total Risks: {0}'}" FontSize="14" TextColor="#666"/>
                </VerticalStackLayout>
            </Frame>

            <CollectionView ItemsSource="{Binding ActiveRisks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="risk:WeatherRisk">
                        <Frame Padding="16" Margin="0,8" BackgroundColor="White" CornerRadius="12" HasShadow="True">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold"/>
                                <Label Text="{Binding Description}" FontSize="14" TextColor="#666" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding RecommendedAction}" FontSize="14" TextColor="#FF5722" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding ExpectedAt, StringFormat='Expected: {0:MMM dd, h:mm tt}'}" FontSize="12" TextColor="#999"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="No active risks" IsVisible="{Binding HasRisks, Converter={StaticResource InvertedBoolConverter}}" FontSize="16" TextColor="#666" HorizontalOptions="Center" Margin="0,40,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
