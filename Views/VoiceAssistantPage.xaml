<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:models="clr-namespace:KrishiAI.App.Models"
             x:Class="KrishiAI.App.Views.VoiceAssistantPage"
             x:DataType="viewmodels:VoiceAssistantViewModel"
             Title="{Binding VoiceAssistantText}"
             BackgroundColor="#F9FBF9">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Voice" IconImageSource="microphone.png" Command="{Binding NavigateToVoiceCommand}" />
        <ToolbarItem Text="History" IconImageSource="history.png" Command="{Binding NavigateToHistoryCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="30">



            <!-- Microphone Circle -->
            <Frame CornerRadius="125" 
                   Padding="0" 
                   HeightRequest="250" 
                   WidthRequest="250"
                   HorizontalOptions="Center"
                   BackgroundColor="#81C784"
                   BorderColor="Transparent"
                   HasShadow="False"
                   Margin="0,10,0,10">
                <Grid>
                    <Frame CornerRadius="90" 
                           HeightRequest="180" 
                           WidthRequest="180"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           BackgroundColor="#4CAF50"
                           BorderColor="Transparent"
                           HasShadow="True">
                        <Label Text="🎤" 
                               FontSize="70" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Frame>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartRecordingCommand}"/>
                    </Grid.GestureRecognizers>
                </Grid>
            </Frame>

            <!-- Tap to Speak -->
            <Label Text="{Binding TapToSpeakText}" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="#00332B"
                   HorizontalOptions="Center"
                   Margin="0,-10,0,5"/>

            <!-- Note -->
            <Label Text="{Binding NoteSpeakText}" 
                   FontSize="15" 
                   TextColor="#666666"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <!-- Ask Button -->
            <Button Text="{Binding AskVoiceAssistantText}"
                    Command="{Binding StartRecordingCommand}"
                    BackgroundColor="#8D6E63"
                    TextColor="White"
                    HeightRequest="55"
                    FontSize="18"
                    FontAttributes="Bold"
                    CornerRadius="15"/>

            <!-- Recording/Processing Indicators -->
            <ActivityIndicator IsRunning="{Binding IsRecording}"
                             IsVisible="{Binding IsRecording}"
                             Color="#F44336"
                             HeightRequest="40"
                             Margin="0,20,0,0"/>

            <Label Text="{Binding RecordingText}"
                   IsVisible="{Binding IsRecording}"
                   FontSize="16"
                   TextColor="#F44336"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <ActivityIndicator IsRunning="{Binding IsProcessing}"
                             IsVisible="{Binding IsProcessing}"
                             Color="#4CAF50"
                             HeightRequest="40"
                             Margin="0,20,0,0"/>

            <Label Text="{Binding ProcessingText}"
                   IsVisible="{Binding IsProcessing}"
                   FontSize="16"
                   TextColor="#4CAF50"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Current Transcription -->
            <Frame BackgroundColor="White" 
                   BorderColor="#E0E0E0"
                   CornerRadius="15" 
                   Padding="20"
                   HasShadow="True"
                   IsVisible="{Binding CurrentTranscription, Converter={StaticResource StringNotEmptyConverter}}"
                   Margin="0,20,0,0">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding TranscriptionText}" 
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#666666"/>
                    <Label Text="{Binding CurrentTranscription}" 
                           TextColor="#333333" 
                           FontSize="16"
                           FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Conversation History -->
            <Label Text="{Binding ConversationHistoryText}" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="#333333"
                   Margin="0,30,0,10"
                   IsVisible="{Binding ConversationHistory.Count, Converter={StaticResource IntToBoolConverter}}"/>

            <VerticalStackLayout Spacing="10">
                <CollectionView ItemsSource="{Binding ConversationHistory}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:VoiceCommand">
                            <Grid>
                                <!-- User Message -->
                                <Frame BackgroundColor="#2196F3" 
                                       CornerRadius="15" 
                                       Padding="15" 
                                       Margin="0,5,50,5"
                                       HorizontalOptions="Start"
                                       HasShadow="True"
                                       IsVisible="{Binding IsUserMessage}">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding CommandText}" 
                                               TextColor="White" 
                                               FontSize="15"/>
                                        <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}" 
                                               TextColor="White" 
                                               FontSize="11" 
                                               Opacity="0.8"/>
                                    </VerticalStackLayout>
                                </Frame>

                                <!-- AI Response -->
                                <Frame BackgroundColor="#4CAF50" 
                                       CornerRadius="15" 
                                       Padding="15" 
                                       Margin="50,5,0,5"
                                       HorizontalOptions="End"
                                       HasShadow="True"
                                       IsVisible="{Binding IsUserMessage, Converter={StaticResource InvertedBoolConverter}}">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding CommandText}" 
                                               TextColor="White" 
                                               FontSize="15"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}" 
                                                   TextColor="White" 
                                                   FontSize="11" 
                                                   Opacity="0.8"/>
                                            <Label Grid.Column="1" 
                                                   Text="🔊" 
                                                   FontSize="16">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:VoiceAssistantViewModel}}, Path=PlayResponseCommand}"
                                                                        CommandParameter="{Binding .}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Clear History Button -->
            <Button Text="{Binding Source={x:Static Application.Current}, Path=BindingContext.ClearDetectionHistoryText, FallbackValue='Clear History'}"
                    Command="{Binding ClearHistoryCommand}"
                    BackgroundColor="#FF5722"
                    TextColor="White"
                    HeightRequest="50"
                    FontSize="16"
                    CornerRadius="10"
                    IsVisible="{Binding ConversationHistory.Count, Converter={StaticResource IntToBoolConverter}}"
                    Margin="0,20,0,20"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
