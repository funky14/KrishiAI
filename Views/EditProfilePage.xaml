<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.EditProfilePage"
             x:DataType="viewmodels:EditProfileViewModel"
             Title="{Binding EditProfileText}"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="{Binding EditProfileText}" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   Margin="0,0,0,10"/>

            <!-- Form Frame -->
            <Frame CornerRadius="15" 
                   Padding="20" 
                   BackgroundColor="White" 
                   BorderColor="#E0E0E0"
                   HasShadow="True">
                <VerticalStackLayout Spacing="20">

                    <!-- Full Name Field -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding FullNameText}" 
                               FontSize="15" 
                               TextColor="#333333" 
                               FontAttributes="Bold"/>
                        <Entry x:Name="FullNameEntry"
                               Placeholder="{Binding CurrentFullName}"
                               Text="{Binding FullName}"
                               BackgroundColor="#F5F5F5"
                               TextColor="#333333"
                               PlaceholderColor="#999999"
                               FontSize="15"/>
                        <Label Text="{Binding ErrorMessage}" 
                               FontSize="13" 
                               TextColor="#F44336"
                               IsVisible="{Binding HasError}"
                               Margin="0,-8,0,0"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>

                    <!-- Phone Number Field -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding PhoneNumberText}" 
                               FontSize="15" 
                               TextColor="#333333" 
                               FontAttributes="Bold"/>
                        <Entry x:Name="PhoneNumberEntry"
                               Placeholder="{Binding CurrentPhoneNumber}"
                               Text="{Binding PhoneNumber}"
                               BackgroundColor="#F5F5F5"
                               TextColor="#333333"
                               PlaceholderColor="#999999"
                               FontSize="15"
                               Keyboard="Telephone"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Buttons Section -->
            <VerticalStackLayout Spacing="12">
                <!-- Update Button -->
                <Button Text="{Binding UpdateProfileText}"
                        Command="{Binding UpdateProfileCommand}"
                        BackgroundColor="#4CAF50"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                <!-- Cancel Button -->
                <Button Text="{Binding CancelText}"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#9E9E9E"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        CornerRadius="10"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>
            </VerticalStackLayout>

            <!-- Info Message -->
            <Label Text="Update your profile information below."
                   FontSize="13" 
                   TextColor="#666666"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
