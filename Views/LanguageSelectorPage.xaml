<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             xmlns:models="clr-namespace:KrishiAI.App.Models"
             x:Class="KrishiAI.App.Views.LanguageSelectorPage"
             x:DataType="viewmodels:LanguageSelectorViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">
    <Grid RowDefinitions="Auto,*">
        <Frame Grid.Row="0" CornerRadius="0" Padding="20" BackgroundColor="White" HasShadow="True">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{Binding Title}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}"/>
                <Button Grid.Column="1" Text="✕" FontSize="24" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}" Command="{Binding CloseCommand}"/>
            </Grid>
        </Frame>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="10">
                <CollectionView ItemsSource="{Binding Languages}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SupportedLanguage">
                            <Frame Padding="20" Margin="0,5" CornerRadius="10" BackgroundColor="White" HasShadow="False" BorderColor="{StaticResource Primary}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:LanguageSelectorViewModel}}, Path=SelectLanguageCommand}" CommandParameter="{Binding .}"/>
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Frame Grid.Column="0" WidthRequest="50" HeightRequest="50" CornerRadius="25" Padding="0" BackgroundColor="{StaticResource Primary}" HasShadow="False">
                                        <Label Text="🌐" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Grid.Column="1" Text="{Binding NativeName}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" Margin="15,0,0,0" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Grid.Column="2" Text="✓" FontSize="24" TextColor="{StaticResource Primary}" VerticalOptions="Center" IsVisible="False"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
