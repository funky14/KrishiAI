<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KrishiAI.App.Views.AlertsPage"
             Title="{Binding Title}">

    <ContentPage.Content>
        <VerticalStackLayout Padding="16" Spacing="12">
            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold"/>
            <Label Text="{Binding ErrorMessage}" FontSize="14" TextColor="#666" IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
        </VerticalStackLayout>
    </ContentPage.Content>

</ContentPage>
