<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KrishiAI.App.Views.LoginPage"
             Title="KrishiAI Login"
             BackgroundColor="{StaticResource Primary}">

    <ScrollView>
        <VerticalStackLayout 
            Padding="20"
            Spacing="15"
            VerticalOptions="CenterAndExpand">

            <!-- App Logo/Title -->
            <Label 
                Text="🌾 KrishiAI"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="White"
                Margin="0,0,0,20" />

            <Label 
                Text="Farmer's Disease Detection Assistant"
                FontSize="16"
                HorizontalTextAlignment="Center"
                TextColor="White"
                Opacity="0.8" />

            <!-- Card Container -->
            <Frame 
                CornerRadius="20"
                HasShadow="True"
                Padding="20"
                Margin="0,30,0,0"
                BackgroundColor="White">

                <VerticalStackLayout Spacing="12">

                    <!-- Email Entry -->
                    <Label 
                        Text="Email"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}" />

                    <Entry 
                        x:Name="EmailEntry"
                        Placeholder="Enter your email"
                        PlaceholderColor="#CCCCCC"
                        Text="{Binding Email}"
                        Keyboard="Email"
                        ReturnType="Next"
                        ClearButtonVisibility="WhileEditing"
                        Margin="0,0,0,5" />

                    <!-- Password Entry -->
                    <Label 
                        Text="Password"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        Margin="0,10,0,0" />

                    <Entry 
                        x:Name="PasswordEntry"
                        Placeholder="Enter your password"
                        PlaceholderColor="#CCCCCC"
                        Text="{Binding Password}"
                        IsPassword="True"
                        ReturnType="Go"
                        Margin="0,0,0,5" />

                    <!-- Error Message -->
                    <Label 
                        Text="{Binding ErrorMessage}"
                        FontSize="12"
                        TextColor="{StaticResource Error}"
                        IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        Margin="0,10,0,5"
                        Padding="10"
                        BackgroundColor="#FFEBEE" />

                    <!-- Login Button -->
                    <Button 
                        Text="Login"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,15,0,10"
                        FontSize="16"
                        FontAttributes="Bold" />

                    <!-- Signup Link -->
                    <HorizontalStackLayout 
                        Spacing="5"
                        HorizontalOptions="Center">
                        <Label 
                            Text="Don't have an account?"
                            FontSize="14"
                            TextColor="#666666" />
                        <Label 
                            Text="Sign Up"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding NavigateToSignupCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Forgot Password Link -->
                    <Label 
                        Text="Forgot Password?"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center"
                        Margin="0,10,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding NavigateToForgotPasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Loading Indicator -->
                    <ActivityIndicator 
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="{StaticResource Primary}"
                        Scale="1.5"
                        Margin="0,10,0,0" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
