<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{Binding SettingsText}"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="{Binding SettingsText}" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   Margin="0,10,0,10"/>

            <!-- Preferences Section -->
            <Label Text="{Binding PreferencesText}" FontSize="18" FontAttributes="Bold" TextColor="#333333"/>

            <Frame CornerRadius="15" 
                   Padding="20" 
                   BackgroundColor="White" 
                   BorderColor="#E0E0E0"
                   HasShadow="True">
                <VerticalStackLayout Spacing="20">

                    <!-- Language Selection -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding DefaultLanguageText}" FontSize="15" TextColor="#333333" FontAttributes="Bold"/>
                        <Picker x:Name="LanguagePicker"
                                ItemsSource="{Binding SupportedLanguages}"
                                SelectedItem="{Binding SelectedLanguage}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                BackgroundColor="#F5F5F5"
                                TextColor="#333333"
                                FontSize="15"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>

                    <!-- Save History Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="{Binding SaveHistoryText}" FontSize="15" TextColor="#333333" FontAttributes="Bold"/>
                            <Label Text="{Binding SaveHistoryDescText}" FontSize="13" TextColor="#666666"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding SaveHistory}" 
                                OnColor="#4CAF50"
                                VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>

                    <!-- Auto Play Responses Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="{Binding AutoPlayResponsesText}" FontSize="15" TextColor="#333333" FontAttributes="Bold"/>
                            <Label Text="{Binding AutoPlayResponsesDescText}" FontSize="13" TextColor="#666666"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding AutoPlayResponses}" 
                                OnColor="#4CAF50"
                                VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- Save Settings Button -->
            <Button Text="{Binding SaveSettingsText}"
                    Command="{Binding SaveSettingsCommandCommand}"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="10"/>

            <!-- Data Management Section -->
            <Label Text="{Binding DataManagementText}" FontSize="18" FontAttributes="Bold" TextColor="#333333" Margin="0,10,0,0"/>

            <VerticalStackLayout Spacing="10">
                <Button Text="{Binding ClearCacheText}"
                        Command="{Binding ClearCacheCommand}"
                        BackgroundColor="#FF9800"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        CornerRadius="10"/>

                <Button Text="{Binding ClearDetectionHistoryText}"
                        Command="{Binding ClearHistoryCommand}"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        CornerRadius="10"/>
            </VerticalStackLayout>

            <!-- About Section -->
            <Label Text="{Binding AboutKrishiAIText}" FontSize="18" FontAttributes="Bold" TextColor="#333333" Margin="0,10,0,0"/>

            <Frame CornerRadius="15" 
                   Padding="20" 
                   BackgroundColor="White" 
                   BorderColor="#E0E0E0"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding AppNameText}" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="#2E7D32"/>
                    <Label Text="{Binding AppVersion, StringFormat='{0} {1}'}" 
                           FontSize="14" 
                           TextColor="#666666">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding VersionText}"/>
                                <Span Text=" "/>
                                <Span Text="{Binding AppVersion}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{Binding AppDescriptionText}" 
                           FontSize="14" 
                           TextColor="#666666"
                           LineBreakMode="WordWrap"/>

                    <Label Text="{Binding FeaturesText}" FontSize="15" FontAttributes="Bold" TextColor="#333333" Margin="0,10,0,5"/>
                    <Label Text="{Binding FeatureAIPoweredText}" FontSize="14" TextColor="#666666"/>
                    <Label Text="{Binding FeatureMultiLanguageText}" FontSize="14" TextColor="#666666"/>
                    <Label Text="{Binding FeatureVoiceBasedText}" FontSize="14" TextColor="#666666"/>
                    <Label Text="{Binding FeatureTreatmentText}" FontSize="14" TextColor="#666666"/>
                    <Label Text="{Binding FeatureOfflineFirstText}" FontSize="14" TextColor="#666666"/>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,10,0,10"/>

                    <Label Text="{Binding CopyrightText}" 
                           FontSize="13" 
                           TextColor="#999999" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
