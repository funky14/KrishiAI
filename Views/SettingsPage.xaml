<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Settings"
             BackgroundColor="#E8F5E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Settings" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   Margin="0,10,0,10"/>

            <!-- Preferences Section -->
            <Label Text="⚙️ Preferences" FontSize="18" FontAttributes="Bold" TextColor="#333333"/>

            <Frame CornerRadius="15" 
                   Padding="20" 
                   BackgroundColor="White" 
                   BorderColor="#E0E0E0"
                   HasShadow="True">
                <VerticalStackLayout Spacing="20">
                    
                    <!-- Language Selection -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Default Language" FontSize="15" TextColor="#333333" FontAttributes="Bold"/>
                        <Picker x:Name="LanguagePicker"
                                SelectedItem="{Binding SelectedLanguage}"
                                BackgroundColor="#F5F5F5"
                                TextColor="#333333"
                                FontSize="15">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>en-US</x:String>
                                    <x:String>hi-IN</x:String>
                                    <x:String>mr-IN</x:String>
                                    <x:String>ta-IN</x:String>
                                    <x:String>te-IN</x:String>
                                    <x:String>pa-IN</x:String>
                                    <x:String>gu-IN</x:String>
                                    <x:String>bn-IN</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>

                    <!-- Save History Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Save History" FontSize="15" TextColor="#333333" FontAttributes="Bold"/>
                            <Label Text="Store detection results locally" FontSize="13" TextColor="#666666"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding SaveHistory}" 
                                OnColor="#4CAF50"
                                VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0"/>

                    <!-- Auto Play Responses Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                            <Label Text="Auto Play Responses" FontSize="15" TextColor="#333333" FontAttributes="Bold"/>
                            <Label Text="Automatically play voice responses" FontSize="13" TextColor="#666666"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" 
                                IsToggled="{Binding AutoPlayResponses}" 
                                OnColor="#4CAF50"
                                VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- Data Management Section -->
            <Label Text="🗂️ Data Management" FontSize="18" FontAttributes="Bold" TextColor="#333333" Margin="0,10,0,0"/>

            <VerticalStackLayout Spacing="10">
                <Button Text="🗑️ Clear Cache"
                        Command="{Binding ClearCacheCommand}"
                        BackgroundColor="#FF9800"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        CornerRadius="10"/>

                <Button Text="🗑️ Clear Detection History"
                        Command="{Binding ClearHistoryCommand}"
                        BackgroundColor="#F44336"
                        TextColor="White"
                        HeightRequest="50"
                        FontSize="16"
                        CornerRadius="10"/>
            </VerticalStackLayout>

            <!-- About Section -->
            <Label Text="ℹ️ About KrishiAI" FontSize="18" FontAttributes="Bold" TextColor="#333333" Margin="0,10,0,0"/>

            <Frame CornerRadius="15" 
                   Padding="20" 
                   BackgroundColor="White" 
                   BorderColor="#E0E0E0"
                   HasShadow="True">
                <VerticalStackLayout Spacing="12">
                    <Label Text="🌾 KrishiAI" 
                           FontSize="20" 
                           FontAttributes="Bold" 
                           TextColor="#2E7D32"/>
                    <Label Text="{Binding AppVersion, StringFormat='Version {0}'}" 
                           FontSize="14" 
                           TextColor="#666666"/>
                    <Label Text="Your AI-powered farming assistant that helps detect crop diseases and provides agricultural advice in multiple Indian languages." 
                           FontSize="14" 
                           TextColor="#666666"
                           LineBreakMode="WordWrap"/>
                    
                    <Label Text="Features:" FontSize="15" FontAttributes="Bold" TextColor="#333333" Margin="0,10,0,5"/>
                    <Label Text="• AI-powered disease detection" FontSize="14" TextColor="#666666"/>
                    <Label Text="• 7+ Indian languages support" FontSize="14" TextColor="#666666"/>
                    <Label Text="• Voice-based assistance" FontSize="14" TextColor="#666666"/>
                    <Label Text="• Treatment recommendations" FontSize="14" TextColor="#666666"/>
                    <Label Text="• Offline-first architecture" FontSize="14" TextColor="#666666"/>
                    
                    <BoxView HeightRequest="1" BackgroundColor="#E0E0E0" Margin="0,10,0,10"/>
                    
                    <Label Text="© 2026 KrishiAI Team" 
                           FontSize="13" 
                           TextColor="#999999" 
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
