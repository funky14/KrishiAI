<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- App Info -->
            <Frame CornerRadius="15" Padding="20" BackgroundColor="{StaticResource Primary}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding AppNameText}" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{Binding AppVersion, StringFormat='Version {0}'}" FontSize="14" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="{Binding AppTaglineText}" FontSize="14" TextColor="White" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Preferences Section -->
            <Label Text="{Binding PreferencesText}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>

            <Frame CornerRadius="10" Padding="15" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout Spacing="15">

                    <!-- Language Selection -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding DefaultLanguageText}" FontSize="16" TextColor="{StaticResource TextPrimary}"/>
                        <Picker x:Name="LanguagePicker"
                                ItemsSource="{Binding AvailableLanguages}"
                                SelectedItem="{Binding SelectedLanguage}"
                                ItemDisplayBinding="{Binding NativeName}"
                                BackgroundColor="White"
                                TextColor="{StaticResource TextPrimary}">
                        </Picker>
                        <Label Text="{Binding LanguageHelpText}" 
                               FontSize="11" 
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,2,0,0"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource TextSecondary}" Opacity="0.3"/>

                    <!-- Save History Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding SaveHistoryText}" FontSize="16" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="{Binding SaveHistoryDescText}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding SaveHistory}" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource TextSecondary}" Opacity="0.3"/>

                    <!-- Auto Play Responses Toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding AutoPlayText}" FontSize="16" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="{Binding AutoPlayDescText}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding AutoPlayResponses}" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- Save Settings Button -->
            <Button Text="{Binding SaveSettingsText}"
                    Command="{Binding SaveSettingsCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    HeightRequest="60"
                    FontSize="18"
                    CornerRadius="10"/>

            <!-- Data Management Section -->
            <Label Text="{Binding DataManagementText}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,20,0,0"/>

            <Frame CornerRadius="10" Padding="15" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout Spacing="15">

                    <Button Text="{Binding ClearCacheText}"
                            Command="{Binding ClearCacheCommand}"
                            BackgroundColor="{StaticResource Secondary}"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="10"/>

                    <Button Text="{Binding ClearHistoryText}"
                            Command="{Binding ClearHistoryCommand}"
                            BackgroundColor="{StaticResource Error}"
                            TextColor="White"
                            HeightRequest="50"
                            CornerRadius="10"/>

                </VerticalStackLayout>
            </Frame>

            <!-- About Section -->
            <Label Text="{Binding AboutText}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,20,0,0"/>

            <Frame CornerRadius="10" Padding="20" BackgroundColor="{StaticResource CardBackground}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding AppDescriptionText}" 
                           FontSize="14" 
                           TextColor="{StaticResource TextSecondary}"/>

                    <Label Text="{Binding FeaturesTitleText}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,10,0,5"/>
                    <Label Text="{Binding Feature1Text}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{Binding Feature2Text}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{Binding Feature3Text}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{Binding Feature4Text}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>

                    <Label Text="{Binding CopyrightText}" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" Margin="0,20,0,0"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
