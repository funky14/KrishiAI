<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KrishiAI.App.ViewModels"
             x:Class="KrishiAI.App.Views.AiInsightsPage"
             Title="AI Insights"
             BackgroundColor="#f8f9fa">

    <ScrollView>
        <VerticalStackLayout Padding="15" Spacing="20">
            
            <VerticalStackLayout Spacing="5" Margin="0,0,0,10">
                <Label Text="Smart suggestions for you" FontSize="18" FontAttributes="Bold" TextColor="#2c2c2c" />
                <Label Text="Based on your recent financial data" FontSize="12" TextColor="#666" />
            </VerticalStackLayout>
            
            <!-- Cost Optimization -->
            <Frame Padding="15" CornerRadius="16" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                <Grid ColumnDefinitions="Auto,*">
                    <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#fff1f0" BorderColor="Transparent" Padding="0" Margin="0,0,15,0" HorizontalOptions="Center" VerticalOptions="Start">
                        <Label Text="📉" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Cost Optimization" FontSize="14" FontAttributes="Bold" TextColor="#2c2c2c" />
                        <Label Text="{Binding CostOptimization}" FontSize="12" TextColor="#666" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>
            
            <!-- Profit Improvement -->
            <Frame Padding="15" CornerRadius="16" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                <Grid ColumnDefinitions="Auto,*">
                    <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#eef8ef" BorderColor="Transparent" Padding="0" Margin="0,0,15,0" HorizontalOptions="Center" VerticalOptions="Start">
                        <Label Text="🚀" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Profit Improvement" FontSize="14" FontAttributes="Bold" TextColor="#2c2c2c" />
                        <Label Text="{Binding ProfitImprovement}" FontSize="12" TextColor="#666" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>
            
            <!-- Loan Readiness -->
            <Frame Padding="15" CornerRadius="16" HasShadow="True" BorderColor="Transparent" BackgroundColor="White">
                <Grid ColumnDefinitions="Auto,*">
                    <Frame Grid.Column="0" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#f2f3ff" BorderColor="Transparent" Padding="0" Margin="0,0,15,0" HorizontalOptions="Center" VerticalOptions="Start">
                        <Label Text="🏦" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Frame>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Loan Readiness" FontSize="14" FontAttributes="Bold" TextColor="#2c2c2c" />
                        <Label Text="{Binding LoanReadiness}" FontSize="12" TextColor="#666" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>
            
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#0f8d39" HorizontalOptions="Center" Margin="0,20,0,0" />
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
