<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KrishiAI.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:KrishiAI.App.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.TabBarBackgroundColor="{StaticResource Primary}"
    Shell.TabBarForegroundColor="White"
    Shell.TabBarUnselectedColor="#B3FFFFFF">

    <!-- Home Tab -->
    <TabBar>
        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <!-- Crop Disease Tab -->
        <ShellContent
            Title="Disease"
            Icon="leaf.png"
            ContentTemplate="{DataTemplate views:CropDiseasePage}"
            Route="disease" />


        <!-- Finance Tab -->
        <ShellContent
            Title="Finance"
            Icon="wallet.png"
            ContentTemplate="{DataTemplate views:FinancePage}"
            Route="finance" />

        <!-- Settings Tab -->
        <ShellContent
            Title="Settings"
            Icon="settings.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>

    <!-- Routes for modal navigation -->
    <ShellContent Route="editprofile" ContentTemplate="{DataTemplate views:EditProfilePage}" />

</Shell>
