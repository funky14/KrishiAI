<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KrishiAI.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="True"
    Shell.TabBarBackgroundColor="{StaticResource Primary}"
    Shell.TabBarForegroundColor="White"
    Shell.TabBarUnselectedColor="#B3FFFFFF">

    <!-- Home Tab -->
    <TabBar>
        <ShellContent
            Title="Home"
            Icon="home.png"
            Route="home" />

        <!-- Crop Disease Tab -->
        <ShellContent
            Title="Disease"
            Icon="leaf.png"
            Route="disease" />

        <!-- Voice Assistant Tab -->
        <ShellContent
            Title="Voice"
            Icon="microphone.png"
            Route="voice" />

        <!-- History Tab -->
        <ShellContent
            Title="History"
            Icon="history.png"
            Route="history" />

        <!-- Settings Tab -->
        <ShellContent
            Title="Settings"
            Icon="settings.png"
            Route="settings" />
    </TabBar>

</Shell>
