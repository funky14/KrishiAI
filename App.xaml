<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:KrishiAI.App.Helpers"
             x:Class="KrishiAI.App.App">
    <Application.Resources>
        <ResourceDictionary>
            
            <!-- Converters -->
            <helpers:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <helpers:NotNullConverter x:Key="NotNullConverter"/>
            <helpers:IsNotNullConverter x:Key="IsNotNullConverter"/>
            <helpers:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter"/>
            <helpers:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            
            <!-- Colors -->
            <Color x:Key="Primary">#4CAF50</Color>
            <Color x:Key="PrimaryDark">#388E3C</Color>
            <Color x:Key="Secondary">#795548</Color>
            <Color x:Key="Accent">#2196F3</Color>
            <Color x:Key="Error">#F44336</Color>
            <Color x:Key="Success">#388E3C</Color>
            <Color x:Key="BackgroundColor">#F5F5F5</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
